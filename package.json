{

  "name": "@vfo/vfool",
  "version": "0.1.0",
  "description": "Componenti React Bootstrap riusabili",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "src/theme"
  ],

  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],

  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },

    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },

    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },

    "./styles.css": "./dist/style.css",
    "./scss/*": "./src/theme/*",
    "./package.json": "./package.json"
  },

  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },

  "peerDependencies": {
    "bootstrap": "^5.3.0",
    "react": ">=19",
    "react-bootstrap": "^2.10.0",
    "react-dom": ">=19"
  },

  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bootstrap": "^5.3.8",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.1",
    "sass": "^1.106.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2"
  },

  "dependencies": {
    "@ag-grid-community/locale": "^36.2.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "react-icons": "^5.7.0"
  }

}

